# Copier en .env pour le développement ; ne jamais commiter vos identifiants réels.
PORT=3000
DATA_DIR=data
# Atelier de démonstration uniquement en développement ; connexion obligatoire.
SEED_DEMO=1
# Facultatif : remplace le mot de passe de démonstration à la première initialisation.
DEMO_PASSWORD=

# Adresse publique HTTPS recommandée (obligatoire pour les webhooks de paiement).
# Vercel peut également déduire automatiquement son URL de déploiement.
PUBLIC_BASE_URL=

# Vercel + PostgreSQL : connecter Neon au projet Vercel. Cette variable est
# normalement injectée automatiquement ; utiliser l'URL DIRECTE, pas -pooler.
# Ne définir USE_POSTGRES=1 que pour les tests locaux ; Vercel active PostgreSQL seul.
DATABASE_URL_UNPOOLED=

# Vercel Blob : connecter un STORE PUBLIC au projet pour les photos de vitrine.
# BLOB_STORE_ID et VERCEL_OIDC_TOKEN sont fournis automatiquement par Vercel.
# Hors Vercel, le SDK peut utiliser BLOB_READ_WRITE_TOKEN si nécessaire.

# Autorise exclusivement l'appel du Cron Vercel /api/cron/reminders.
CRON_SECRET=

# Obligatoires en production. Générer chacun avec : openssl rand -hex 32
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Rappels SMS uniquement (Twilio). La connexion utilise un mot de passe.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Paiement mobile réel via CinetPay Checkout
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# WhatsApp Business Cloud API. Modèle approuvé en langue fr avec
# trois variables dans le corps : nom du client, type de rappel, date.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
